<?xml version="1.0" encoding="utf-8"?>
<!-- Do not remove this test for UTF-8: if “Ω” doesn’t appear as greek uppercase omega letter
enclosed in quotation marks, you should use an editor that supports UTF-8, not this one. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
	<metadata>
		<id>rtd</id>
		<version>$version$</version>
		<owners>LinkUVerse</owners>
		<title>Main Rtd Binary</title>
		<authors>LinkUVerse</authors>
		<projectUrl>https://github.com/LinkUVerse/rtd</projectUrl>
		<licenseUrl>https://github.com/LinkUVerse/rtd/blob/main/LICENSE</licenseUrl>
		<projectSourceUrl>https://github.com/LinkUVerse/rtd/</projectSourceUrl>
		<bugTrackerUrl>https://github.com/LinkUVerse/rtd/issues</bugTrackerUrl>
		<tags>rtd</tags>
		<summary>RTD blockchain command-line tools</summary>
		<description>Command-line tools for the RTD blockchain fork</description>
		<releaseNotes>See https://github.com/LinkUVerse/rtd/releases/tag/testnet-v$version$</releaseNotes>
	</metadata>
	<files>
		<file src="../tmp/release/rtd.exe" target="bin/rtd.exe" />
		<file src="../LICENSE" target="bin/LICENSE.txt" />
		<file src="./VERIFICATION.txt" target="bin/VERIFICATION.txt" />
	</files>
</package>
