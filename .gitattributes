# Use Move syntax highlighter for Move IR code
*.mvir linguist-language=Move

# These files are used in "porcelain" file comparison,
# we don't want an equality to fail because of line endings.
crates/rtd-core/tests/staged/rtd.yaml text eol=lf
crates/rtd-open-rpc/spec/openrpc.json text eol=lf
rtd_core/tests/staged/rtd.yaml text eol=lf
crates/rtd/tests/**/*.ptb text eol=lf
crates/rtd/tests/**/*.sh text eol=lf
crates/rtd/tests/snapshots/**/*.snap text eol=lf
crates/rtd/src/unit_tests/fixtures/**/*.toml text eol=lf
crates/rtd/src/unit_tests/fixtures/**/*.move text eol=lf
